# 本机服务与固定报告链接
HOST=127.0.0.1
PORT=8099
REPORT_ORIGIN=http://127.0.0.1:8099
DEBUG=true
# backend 目录相对持久化路径
DATABASE_PATH=data/tess-chrome.db
UPLOAD_DIR=data/uploads
# 仅明确允许的前端来源；正式扩展 ID 由 frontend/extension-identity.json 公钥固定
CORS_ORIGINS=["http://localhost:5199","http://127.0.0.1:5199","http://localhost:5175","http://127.0.0.1:5175"]
ALLOWED_EXTENSION_ORIGIN=chrome-extension://ejbpocfjkdofijfgehnnhdnnhigkekdn
ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]
# 百炼业务空间地址及密钥，仅在本文件真实副本填写
BAILIAN_BASE_URL=
BAILIAN_API_KEY=
LLM_MODEL=qwen3.7-plus
ASR_MODEL=qwen3-asr-flash-realtime
BAILIAN_ASR_WS_URL=
LLM_ENABLE_THINKING=false
# 实时转写工程参数
ASR_CONNECT_TIMEOUT=10
ASR_FINISH_TIMEOUT=10
ASR_SAMPLE_RATE=16000
ASR_CHUNK_MS=100
ASR_BUFFER_SECONDS=2
ASR_VAD_THRESHOLD=0.0
ASR_VAD_SILENCE_MS=400
ASR_SESSION_MAX_SECONDS=300
ASR_CONNECT_TTL_SECONDS=60
# 高德真实 Web Service 凭证
AMAP_WEB_SERVICE_KEY=
AMAP_BASE_URL=https://restapi.amap.com
MAP_RADIUS_M=5000
MAP_STATION_LIMIT=3
# 请求和有界执行参数
HTTP_CONNECT_TIMEOUT=5
MAP_TIMEOUT=10
MODEL_TIMEOUT=60
RUN_TIMEOUT=180
MAX_MODEL_ROUNDS=6
MAX_TOOL_CALLS=10
RUN_POLL_INTERVAL_MS=1000
CAPTURE_STABLE_MS=500
MAX_TEXT_CHARS=12000
LIST_PAGE_SIZE=20
LIST_MAX_PAGE_SIZE=50
MAX_ACTIVE_CAPTURES=3
MAX_QUESTIONS_PER_ROUND=3
DEFAULT_PHONE_REGION=CN
MAX_NICKNAME_CHARS=80
MAX_EMAIL_CHARS=254
