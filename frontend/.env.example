# Web uses the same-origin proxy; never put service secrets in frontend variables.
VITE_API_BASE_URL=/api
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8099
# Extension pages cannot use a Web relative /api route; this is loopback only.
VITE_EXTENSION_API_ORIGIN=http://127.0.0.1:8099
# Explicit contract-only demo. Keep false for real extension/backend work.
VITE_CONTRACT_MOCK=false
