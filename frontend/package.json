{
  "name": "tess-chrome-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && VITE_CONTRACT_MOCK=true vite build && node scripts/package-extension.mjs",
    "type-check": "tsc -b --pretty false",
    "lint": "eslint src",
    "test": "node --experimental-strip-types --test src/utils/*.test.ts src/audio/*.test.ts",
    "test:report": "node scripts/test-report-ssr.mjs"
  },
  "dependencies": {
    "axios": "^1.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/chrome": "^0.1.15",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  }
}
